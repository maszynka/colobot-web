/*
  X-Content-Type-Options: nosniff
  Cache-Control: no-cache

/*.wasm
  Content-Type: application/wasm

# Content-addressed (name.<sha256>.ext, see tools/build-data/build.mjs): safe to cache forever.
# "! Cache-Control" drops the /* value first; otherwise Cloudflare joins both with a comma.
/data/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/data/manifest.json
  ! Cache-Control
  Cache-Control: no-cache
